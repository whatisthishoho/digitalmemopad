# digitalmemopad — 설정값 예시 (실제 값 아님)
#
# ※ 현재 코드는 이 파일을 읽지 않습니다. 빌드 도구가 없는 순수 정적 HTML + Google Apps Script 구조라서
#   아래 값은 각 파일 상단의 상수에 직접 넣습니다. (배포 자동화 시 치환용 변수 이름으로 쓰면 됩니다)
#   두 값 모두 비밀값이 아닙니다. 웹앱 URL은 브라우저에 그대로 노출되는 공개 주소입니다.

# Apps Script 웹앱 배포 URL (/exec 로 끝남)
# 넣는 위치: index.html, memopad.html 의 var APPS_SCRIPT_URL = "";
# 비워두면 두 화면 모두 '미리보기 모드'(이 브라우저 localStorage에만 저장)로 동작
APPS_SCRIPT_URL=https://script.google.com/macros/s/EXAMPLE_DEPLOYMENT_ID/exec

# 데이터를 저장할 Google 스프레드시트 ID (선택)
# 넣는 위치: Code.gs 의 var SHEET_ID = "";
# 시트에 묶인(컨테이너 바인딩) Apps Script 프로젝트라면 비워둠
SHEET_ID=EXAMPLE_SPREADSHEET_ID
